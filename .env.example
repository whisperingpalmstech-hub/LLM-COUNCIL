PORT=3000
DATABASE_URL=./data/synod.sqlite
PROVIDER_MODE=mock

# Optional real provider keys. Leave blank to use built-in mocks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional web search provider.
TAVILY_API_KEY=
PERPLEXITY_API_KEY=

# Optional AnythingLLM.
ANYTHINGLLM_BASE_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=

# Ollama Local Router
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_ROUTER_MODEL=llama3.1:8b

# Hermes Webhook Auto-Deploy
HERMES_WEBHOOK_URL=
HERMES_API_KEY=

# Obsidian Knowledge Graph
OBSIDIAN_VAULT_PATH=./data/synod-brain-vault
