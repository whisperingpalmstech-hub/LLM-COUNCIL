# ---- Server ----
PORT=3000
# Database, uploads and other runtime files live here (git-ignored).
SYNOD_DATA_DIR=./data
# Accounts. The first account becomes the administrator. Set these to create it on startup
# (otherwise the first person to sign up becomes admin).
SYNOD_ADMIN_EMAIL=
SYNOD_ADMIN_PASSWORD=
SYNOD_ADMIN_NAME=
# Testers sign up with this code. Leave blank to close sign-ups; SYNOD_SIGNUP=open allows anyone.
SYNOD_INVITE_CODE=
# "Continue with Google": create an OAuth client (Web application) in Google Cloud Console and add
# <PUBLIC_BASE_URL>/api/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin used for the phone QR code, e.g. https://synod.example.com (defaults to your LAN IP).
PUBLIC_BASE_URL=
# Optional HTTPS (browsers require it for microphone access off localhost).
SYNOD_TLS_CERT_PATH=
SYNOD_TLS_KEY_PATH=

# ---- Model providers ----
# Each configured provider becomes available to council members (Council settings in the UI).
# With no keys, Synod runs a clearly-labelled mock council.
PROVIDER_REQUEST_TIMEOUT_MS=120000
PROVIDER_MAX_RETRIES=1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=4096
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# With an OpenRouter key, the default council seats these models (comma-separated) and chairman.
OPENROUTER_COUNCIL_MODELS=openai/gpt-6.1-terra,anthropic/claude-sonnet-5.5,google/gemini-4-argon,x-ai/grok-4.7
OPENROUTER_CHAIRMAN_MODEL=anthropic/claude-sonnet-5.5
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct

# Local Ollama (set the URL to enable).
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b

# RouteLLM: a separate local OpenAI-compatible routing service.
ROUTELLM_ENABLED=false
ROUTELLM_BASE_URL=http://127.0.0.1:6060
ROUTELLM_MODEL=router-mf-0.11593

# AnythingLLM workspaces: a member's "model" is the workspace slug.
ANYTHINGLLM_BASE_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_WORKSPACE_DEFAULT=synod
ANYTHINGLLM_DOCKER_BASE_URL=http://anythingllm:3001

# ---- Optional integrations ----
# Web search shared with the council (Exa).
EXA_API_KEY=

# Voice input: local whisper.cpp if installed, else OpenRouter (cheap audio model), else OpenAI.
OPENROUTER_TRANSCRIBE_MODEL=google/gemini-2.5-flash-lite
WHISPER_CPP_BIN=./vendor/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL_PATH=./data/whisper-models/ggml-base.bin
FFMPEG_BIN=ffmpeg

# Write every council answer to an Obsidian vault.
OBSIDIAN_VAULT_PATH=

# Hand execution plans to Hermes (simulated when unset). Always requires an explicit click.
HERMES_WEBHOOK_URL=
HERMES_API_KEY=
