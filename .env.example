PORT=3000
DATABASE_URL=./data/synod.sqlite
PROVIDER_MODE=mock
# Maximum time allowed for a single provider response. Slow providers should
# be given enough time to finish rather than being aborted mid-turn.
PROVIDER_REQUEST_TIMEOUT_MS=60000
PROVIDER_MAX_RETRIES=1
# Optional comma-separated origins for intentionally cross-origin API clients.
# Same-origin browser access works without this setting.
CORS_ORIGIN=
# Recommended for any network-accessible deployment. The browser will show a
# standard sign-in prompt. Health checks remain accessible without credentials.
SYNOD_ACCESS_USERNAME=synod
SYNOD_ACCESS_PASSWORD=
# Public HTTPS origin used by the phone QR bridge, e.g. https://synod.example.com
PUBLIC_BASE_URL=

# Optional real provider keys. Leave blank to use built-in mocks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# Cost-aware Claude routing: Haiku for routine roles, Sonnet for final synthesis.
ANTHROPIC_HAIKU_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=1400
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional: RouteLLM runs as a separate local OpenAI-compatible routing service.
# Leave disabled unless the service and its strong/weak provider configuration are ready.
ROUTELLM_ENABLED=false
ROUTELLM_BASE_URL=http://127.0.0.1:6060
ROUTELLM_THRESHOLD=0.55
ROUTELLM_ESTIMATED_COST_PER_1K=0.003

# Optional local speech-to-text fallback (whisper.cpp). Defaults point to the
# workspace-local install created by Synod's voice setup.
WHISPER_CPP_BIN=./vendor/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL_PATH=./data/whisper-models/ggml-base.bin
FFMPEG_BIN=ffmpeg
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct

# Optional web search provider.
TAVILY_API_KEY=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Optional AnythingLLM.
ANYTHINGLLM_BASE_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=
# Docker Compose only: defaults to the bundled AnythingLLM service.
ANYTHINGLLM_DOCKER_BASE_URL=http://anythingllm:3001

# Ollama Local Router
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_ROUTER_MODEL=llama3.1:8b

# Hermes Webhook Auto-Deploy
HERMES_WEBHOOK_URL=
HERMES_API_KEY=

# Obsidian Knowledge Graph
OBSIDIAN_VAULT_PATH=./data/synod-brain-vault
